<Window x:Class="MoyuCast.MainWindow"
        Icon="Assets/MoyuCast.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MoyuCast.Services"
        Title="MoyuCast" Height="760" Width="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WinBrush" Color="#1E1F22"/>
        <SolidColorBrush x:Key="SideBrush" Color="#232428"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2A2B30"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3B40"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9AA0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D9BFF"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#48484A"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1C20"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1B1C20" BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#9A9AA0"
                                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2A2B30" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" Padding="4">
                                    <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3A3B40"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3B40"/>
                                <Setter Property="Foreground" Value="#7A7A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#35363B" BorderBrush="#45464C" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F4046"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="6,6" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2F34"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{StaticResource TrackBrush}">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="8,7" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35363B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="#3A3B40"/>
                            <TextBlock x:Name="Glyph" Text="" FontSize="8" Foreground="#5A5A5A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="close">
                                <Setter TargetName="Dot" Property="Fill" Value="#FF5F57"/>
                                <Setter TargetName="Glyph" Property="Text" Value="✕"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="#7A1F1A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="min">
                                <Setter TargetName="Dot" Property="Fill" Value="#FEBC2E"/>
                                <Setter TargetName="Glyph" Property="Text" Value="—"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="#8A6410"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>    <Border CornerRadius="14" Background="{StaticResource WinBrush}" BorderBrush="#3A3B40" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="BtnClose" AutomationProperties.Name="关闭" Tag="close" Style="{StaticResource TrafficLight}" Click="BtnClose_Click"/>
                    <Button x:Name="BtnMin" AutomationProperties.Name="最小化到托盘" Tag="min" Style="{StaticResource TrafficLight}" Click="BtnMin_Click"/>
                    <Ellipse Width="12" Height="12" Fill="#3A3B40"/>
                </StackPanel>
                <TextBlock Text="MoyuCast" Foreground="#C7C7CC" FontSize="12.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Margin="12,0,12,8" Background="#26272B" CornerRadius="10" Padding="4">
                <UniformGrid Columns="4">
                    <Button x:Name="Nav0" Tag="active" Style="{StaticResource TabButton}" Content="{Binding [设备], Source={x:Static loc:Loc.Instance}}" Click="Nav_Click"/>
                    <Button x:Name="Nav1" Style="{StaticResource TabButton}" Content="{Binding [画面], Source={x:Static loc:Loc.Instance}}" Click="Nav_Click"/>
                    <Button x:Name="Nav2" Style="{StaticResource TabButton}" Content="{Binding [声音], Source={x:Static loc:Loc.Instance}}" Click="Nav_Click"/>
                    <Button x:Name="Nav3" Style="{StaticResource TabButton}" Content="{Binding [更多], Source={x:Static loc:Loc.Instance}}" Click="Nav_Click"/>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="2" Margin="14,2,14,0">

                <!-- ========== 设备 ========== -->
                <ScrollViewer x:Name="PageDevice" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [设备], Source={x:Static loc:Loc.Instance}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,0,0,12"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [选择设备], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbDevice" Style="{StaticResource DarkCombo}" Height="34"/>
                                    <Button Grid.Column="1" x:Name="BtnRefresh" Content="{Binding [刷新], Source={x:Static loc:Loc.Instance}}" Width="56" Height="34"
                                            Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="BtnRefresh_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [scrcpy 目录], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1B1C20" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Height="34" Padding="9,0">
                                        <TextBlock x:Name="TxtScrcpyDir" Text="…" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="1" AutomationProperties.Name="选择 scrcpy 目录" Content="{Binding [选择], Source={x:Static loc:Loc.Instance}}" Width="56" Height="34" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}" Click="BtnPickScrcpy_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [无线投屏], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkWireless" AutomationProperties.Name="无线投屏" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" Checked="ChkWireless_Changed" Unchecked="ChkWireless_Changed"/>
                                </Grid>
                                <StackPanel x:Name="PnlWireless" Visibility="Collapsed" Margin="0,12,0,0">

                                    <!-- 当前状态 -->
                                    <Border Background="#1B1C20" CornerRadius="8" Padding="10,9" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="WifiDot" Width="8" Height="8" Fill="#8B95A7"
                                                     VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="LblWifiStatus" Margin="8,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="{Binding [未检测到设备], Source={x:Static loc:Loc.Instance}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 场景一：USB 已连接，一键转无线 -->
                                    <Button x:Name="BtnAutoWireless" Height="36"
                                            Content="{Binding [一键转为无线投屏], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource GhostButton}" Click="BtnAutoWireless_Click"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,14" TextWrapping="Wrap"
                                               Text="{Binding [手机已通过 USB 连接时可用：自动读取 WiFi 地址并切换到无线，之后可以拔掉数据线。], Source={x:Static loc:Loc.Instance}}"/>

                                    <!-- 场景二：手动连接 -->
                                    <TextBlock Text="{Binding [手动连接], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtIp" Style="{StaticResource DarkTextBox}" Height="34"
                                                 ToolTip="手机 WiFi IP，例如 192.168.1.20"/>
                                        <TextBox x:Name="TxtPort" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="34"
                                                 Margin="8,0,0,0" Text="5555"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnReadIp" Height="34" Margin="0,0,4,0"
                                                Content="{Binding [读取手机 IP], Source={x:Static loc:Loc.Instance}}"
                                                Style="{StaticResource GhostButton}" Click="BtnReadIp_Click"/>
                                        <Button Grid.Column="1" x:Name="BtnConnect" Height="34" Margin="4,0,0,0"
                                                Content="{Binding [连接到该地址], Source={x:Static loc:Loc.Instance}}"
                                                Style="{StaticResource GhostButton}" Click="BtnConnect_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0" TextWrapping="Wrap"
                                               Text="{Binding [通过 adb connect 建立无线连接，不需要数据线。首次使用需先完成下方配对。], Source={x:Static loc:Loc.Instance}}"/>

                                    <!-- 场景三：首次配对 -->
                                    <Button x:Name="BtnShowPair" Height="30" Margin="0,14,0,0"
                                            Content="{Binding [首次配对（仅 Android 11+ 需要）], Source={x:Static loc:Loc.Instance}}"
                                            Style="{StaticResource GhostButton}" Click="BtnShowPair_Click"/>
                                    <StackPanel x:Name="PnlPair" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Border Background="#1B1C20" CornerRadius="8" Padding="10,9" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [在手机上操作：], Source={x:Static loc:Loc.Instance}}"
                                                           Style="{StaticResource Hint}"/>
                                                <TextBlock Text="{Binding [设置 → 开发者选项 → 无线调试 → 使用配对码配对设备], Source={x:Static loc:Loc.Instance}}"
                                                           Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding [屏幕会显示 6 位配对码和一个 IP:端口], Source={x:Static loc:Loc.Instance}}"
                                                           Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding [配对地址], Source={x:Static loc:Loc.Instance}}"
                                                   Style="{StaticResource Hint}" Margin="2,0,0,4"/>
                                        <TextBox x:Name="TxtPairAddr" Style="{StaticResource DarkTextBox}" Height="34"
                                                 ToolTip="手机显示的配对地址，例如 192.168.8.8:41234"/>
                                        <TextBlock Text="{Binding [配对码], Source={x:Static loc:Loc.Instance}}"
                                                   Style="{StaticResource Hint}" Margin="2,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPairCode" Style="{StaticResource DarkTextBox}" Height="34"
                                                     ToolTip="手机显示的 6 位数字"/>
                                            <Button Grid.Column="1" x:Name="BtnPair" Width="56" Height="34" Margin="8,0,0,0"
                                                    Content="{Binding [配对], Source={x:Static loc:Loc.Instance}}"
                                                    Style="{StaticResource GhostButton}" Click="BtnPair_Click"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" TextWrapping="Wrap"
                                                   Text="{Binding [配对端口是手机随机分配的高位端口，不是 5555；配对只需一次。], Source={x:Static loc:Loc.Instance}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 画面 ========== -->
                <ScrollViewer x:Name="PageDisplay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [画面], Source={x:Static loc:Loc.Instance}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,0,0,12"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [投屏窗口透明度], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LblOpacity" Text="100%" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="SldOpacity" AutomationProperties.Name="投屏窗口透明度" Minimum="20" Maximum="100" Value="100"
                                        Margin="0,10,0,0" IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="SldOpacity_ValueChanged"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding [实时生效，只作用于投屏窗口。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [老板键（隐藏 / 显示投屏窗口）], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1B1C20" BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Height="34">
                                        <TextBlock x:Name="TxtBossKey" Text="Ctrl+Alt+H"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="1" x:Name="BtnCaptureKey" Content="{Binding [录制], Source={x:Static loc:Loc.Instance}}" Width="64" Height="34"
                                            Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="BtnCaptureKey_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [点「录制」后按下你想要的组合键，例如 Alt+` 或 Ctrl+Shift+Q。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding [投屏], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" Margin="2,6,0,8"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [息屏投屏], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkScreenOff" AutomationProperties.Name="息屏投屏" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" Checked="ChkScreenOff_Changed" Unchecked="ChkScreenOff_Changed"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,10" TextWrapping="Wrap"
                                           Text="{Binding [把屏幕亮度压到 0 并保持设备唤醒，电脑端画面和操作不受影响。], Source={x:Static loc:Loc.Instance}}"/>
                                <Button x:Name="BtnApplyDim" Content="{Binding [立即应用 / 恢复], Source={x:Static loc:Loc.Instance}}" Height="32"
                                        Style="{StaticResource GhostButton}" Click="BtnApplyDim_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [锁定窗口比例（无黑边）], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkLockAspect" AutomationProperties.Name="锁定窗口比例" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" IsChecked="True"/>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{Binding [窗口宽度], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="TxtWidth" Style="{StaticResource DarkTextBox}" Width="66" Height="30"
                                                 Text="0" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding [px（0 为自动）], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="{Binding [窗口置顶], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkTop" AutomationProperties.Name="窗口置顶" Style="{StaticResource ToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Checked="ChkTop_Changed" Unchecked="ChkTop_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [模拟物理键盘（打字更可靠）], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkUhid" AutomationProperties.Name="模拟物理键盘" Style="{StaticResource ToggleSwitch}" IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [使用 HID 键盘模式，几乎所有 App 都能收到按键。关闭则用默认 SDK 模式。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                          <Border Style="{StaticResource Card}">
                              <StackPanel>
                                  <Grid>
                                      <TextBlock Text="{Binding [禁用电脑输入法（解决打字无反应）], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                      <CheckBox x:Name="ChkDisableIme" AutomationProperties.Name="禁用电脑输入法" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                                HorizontalAlignment="Right" Checked="ChkDisableIme_Changed" Unchecked="ChkDisableIme_Changed"/>
                                  </Grid>
                                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                             Text="{Binding [中文输入法会拦截字母键，导致电脑打字没反应。开启后投屏窗口绕过电脑输入法。], Source={x:Static loc:Loc.Instance}}"/>
                              </StackPanel>
                          </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [鼠标移开自动隐藏], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <CheckBox x:Name="ChkAutoHide" AutomationProperties.Name="鼠标移开自动隐藏" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                              Checked="ChkAutoHide_Changed" Unchecked="ChkAutoHide_Changed"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [鼠标离开投屏窗口超过 0.5 秒，自动进入老板键隐藏状态；按老板键即可恢复。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 声音 ========== -->
                <ScrollViewer x:Name="PageAudio" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [声音], Source={x:Static loc:Loc.Instance}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,0,0,12"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <UniformGrid Columns="3" Height="38">
                                    <RadioButton x:Name="RadAudio0" GroupName="audio" Style="{StaticResource SegRadio}"
                                                 Content="{Binding [手机响], Source={x:Static loc:Loc.Instance}}" IsChecked="True" Checked="Audio_Checked"/>
                                    <RadioButton x:Name="RadAudio1" GroupName="audio" Style="{StaticResource SegRadio}"
                                                 Content="{Binding [两边响], Source={x:Static loc:Loc.Instance}}" Checked="Audio_Checked"/>
                                    <RadioButton x:Name="RadAudio2" GroupName="audio" Style="{StaticResource SegRadio}"
                                                 Content="{Binding [仅电脑], Source={x:Static loc:Loc.Instance}}" Checked="Audio_Checked"/>
                                </UniformGrid>
                                <TextBlock x:Name="LblAudioHint" Style="{StaticResource Hint}" Margin="2,12,0,0" TextWrapping="Wrap"
                                           Text="{Binding [默认手机出声，电脑不继承。切换会自动重启投屏。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 更多 ========== -->
                <ScrollViewer x:Name="PageMore" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [更多], Source={x:Static loc:Loc.Instance}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="2,0,0,12"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [界面语言], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button x:Name="BtnLangZh" Content="中文" Width="96" Height="32"
                                            Style="{StaticResource GhostButton}" Click="BtnLangZh_Click"/>
                                    <Button x:Name="BtnLangEn" Content="English" Width="96" Height="32" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}" Click="BtnLangEn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [检查更新], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblVersion" Text="{Binding [当前版本], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Label}"/>
                                    <Button Grid.Column="1" x:Name="BtnCheckUpdate" AutomationProperties.Name="检查更新"
                                            Content="{Binding [检查更新], Source={x:Static loc:Loc.Instance}}" Width="84" Height="32"
                                            Style="{StaticResource GhostButton}" Click="BtnCheckUpdate_Click"/>
                                </Grid>
                                <TextBlock x:Name="LblUpdate" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{Binding [从 GitHub Releases 获取最新版本，国内网络自动走镜像。], Source={x:Static loc:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding [运行日志], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <Button x:Name="BtnToggleLog" AutomationProperties.Name="展开或收起日志"
                                            Content="{Binding [展开日志 ▾], Source={x:Static loc:Loc.Instance}}" HorizontalAlignment="Right" Height="28" Padding="10,0"
                                            Style="{StaticResource GhostButton}" Click="BtnToggleLog_Click"/>
                                </Grid>
                                <Border x:Name="PnlLog" Visibility="Collapsed" Height="260" Margin="0,10,0,0"
                                        Background="#141519" CornerRadius="10" Padding="10"
                                        BorderBrush="#2E2F34" BorderThickness="1">
                                    <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                                             Foreground="#8FB8E8" FontFamily="Consolas" FontSize="11.5"
                                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding [关于], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="LblAbout" Style="{StaticResource Hint}" TextWrapping="Wrap" LineHeight="19"/>
                                <Button x:Name="BtnOpenRepo" AutomationProperties.Name="打开项目主页"
                                        Content="{Binding [打开项目主页], Source={x:Static loc:Loc.Instance}}" Height="30" Margin="0,10,0,0"
                                        Style="{StaticResource GhostButton}" Click="BtnOpenRepo_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Border Grid.Row="3" Padding="14,10,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStatus" Text="{Binding [未连接], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" x:Name="BtnStart" Content="{Binding [开始投屏], Source={x:Static loc:Loc.Instance}}" Width="132" Height="40"
                            Style="{StaticResource PrimaryButton}" Click="BtnStart_Click"/>
                </Grid>
            </Border>

            <!-- 加载遮罩 -->
            <Grid x:Name="PnlLoading" Grid.RowSpan="4" Visibility="Collapsed" Background="#D9101114">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="48" Height="48">
                        <Ellipse Stroke="#3A3B40" StrokeThickness="3"/>
                        <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                 StrokeDashArray="1.2 3.2" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="ArcRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="TxtLoading" Text="{Binding [正在连接设备…], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource TextBrush}"
                               FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoadingSub" Text="{Binding [首次启动需要推送服务端，约 2-5 秒], Source={x:Static loc:Loc.Instance}}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>






