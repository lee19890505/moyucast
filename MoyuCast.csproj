<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MoyuCast</AssemblyName>
    <RootNamespace>MoyuCast</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MoyuCast.ico</ApplicationIcon>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- WinForms 的 DPI 警告：DPI 由 app.manifest 与 WPF 统一处理 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.3.0</Version>
    <Product>MoyuCast 摸鱼投屏</Product>
    <AssemblyTitle>MoyuCast</AssemblyTitle>
    <Company>lee19890505</Company>
    <Description>基于 scrcpy 的 Windows 图形化投屏控制台，老板键一键隐身</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MoyuCast.ico" />
    <!-- WinForms 只用于托盘图标，去掉它的隐式 using，避免和 WPF 类型重名 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>



